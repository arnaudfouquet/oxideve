generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model Formation {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  shortTitle      String
  category        String
  duration        String
  durationDetails String?      @db.Text
  location        String
  audience        String
  summary         String        @db.Text
  description     String        @db.Text
  benefits        Json
  objectives      Json
  prerequisites   Json?
  modalities      Json?
  programme       Json?
  certification   String?       @db.Text
  price           String
  priceDetails    String?       @db.Text
  successRate     String?
  handicapPolicy  String?       @db.Text
  seoTitle        String
  seoDescription  String        @db.Text
  videoUrl        String?
  rgeBadge        Json?
  priceMemberLabel String?
  priceMember     String?
  memberProgram   Json?
  faq             Json?
  stats           Json?
  gallery         Json?
  relatedSlugs    Json?
  levelLabel      String?
  subCategory     String?
  cpfEligible     Boolean       @default(false)
  bannerImage     String?
  bannerPosition  String?
  tilePosition    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
}

// Avis client affiché sur la page d'accueil, saisi depuis l'admin.
model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int      @default(5)
  quote     String   @db.Text
  source    String   @default("Google")
  // Agence concernée : "Montpellier", "Toulouse" ou vide.
  city      String?
  // Date affichée ("septembre 2026") ; texte libre car reprise de Google.
  period    String?
  published Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Retour envoyé par une testeuse depuis la page /retours, pendant la phase de
// recette du site. Volontairement sans compte : le lien est partagé tel quel.
model Feedback {
  id        String   @id @default(cuid())
  // Page concernée, choisie dans une liste ("Fiche formation", "Admin — sessions"...).
  page      String
  // "Problème", "Suggestion" ou "Question".
  kind      String   @default("Problème")
  author    String
  message   String   @db.Text
  // Capture d'écran facultative, servie depuis /uploads/retours.
  imageUrl  String?
  // "À traiter", "En cours", "Corrigé" ou "Non retenu".
  status    String   @default("À traiter")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Visuel associé à une catégorie ou à une sous-catégorie de formation.
// `scope` vaut "category" ou "subCategory", `name` est le libellé concerné.
// Une formation peut toujours surcharger ces valeurs.
model CategoryVisual {
  id             String   @id @default(cuid())
  scope          String
  name           String
  image          String?
  bannerPosition String?
  tilePosition   String?
  updatedAt      DateTime @updatedAt

  @@unique([scope, name])
}

model Session {
  id                String        @id @default(cuid())
  formationSlug     String
  city              String
  startDate         DateTime
  endDate           DateTime
  mode              String
  source            String        @default("manual")
  externalId        String?       @unique
  externalTitle     String?
  externalState     String?
  lastSyncedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  formation         Formation     @relation(fields: [formationSlug], references: [slug], onDelete: Cascade)
  inscriptions      Inscription[]
}

model Inscription {
  id                    String      @id @default(cuid())
  companyId             String?
  company               String
  contactName           String
  email                 String
  phone                 String
  formationSlug         String
  sessionId             String?
  message               String?     @db.Text
  status                String      @default("Pré-inscription (à qualifier)")
  origin                String      @default("Formulaire pré-inscription site")
  bulletinInscriptionId String?     @unique
  createdAt             DateTime    @default(now())
  companyRef            Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  session               Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  emailLogs             EmailLog[]
  notesHistory          RegistrationNote[]
}

model RegistrationNote {
  id            String      @id @default(cuid())
  registrationId String
  authorName    String
  text          String      @db.Text
  createdAt     DateTime    @default(now())
  registration  Inscription @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id            String       @id @default(cuid())
  inscriptionId String
  email         String
  status        String
  createdAt     DateTime     @default(now())
  inscription   Inscription  @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
}

model BulletinInscription {
  id                  String    @id @default(cuid())
  formationSlug       String
  sessionId           String?
  sessionDates        String?
  sessionLocation      String?
  source              String?
  distributorName     String?
  companyName         String
  siret               String?
  apeCode             String?
  companyAddress      String?
  sponsorFullName     String
  sponsorRole         String?
  sponsorEmail        String
  sponsorPhone        String
  learners            Json      @default("[]")
  status              String    @default("submitted")
  confirmationEmailSentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  quizAttempts        QuizAttempt[]
}

model QuizAttempt {
  id                     String    @id @default(cuid())
  bulletinInscriptionId  String
  quizSlug               String
  learnerFullName        String
  learnerEmail           String
  companyName            String?
  answers                Json
  scoreOn20              Float
  createdAt              DateTime  @default(now())
  bulletinInscription    BulletinInscription @relation(fields: [bulletinInscriptionId], references: [id], onDelete: Cascade)
}

model Article {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  title                String
  category             String
  excerpt              String    @db.Text
  body                 Json
  // Contenu riche produit par l'éditeur, déjà filtré avant enregistrement.
  // `body` reste alimenté en paragraphes bruts pour les anciens articles.
  bodyHtml             String?   @db.Text
  readingTime          String
  publishedAt          DateTime
  featuredFormationSlug String?
  coverImageUrl        String?
  // Brouillon tant que `published` est faux ; `indexable` pilote le noindex
  // et la présence dans le sitemap.
  published            Boolean   @default(true)
  indexable            Boolean   @default(true)
  seoTitle             String    @default("")
  seoDescription       String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Company {
  id                 String        @id @default(cuid())
  name               String
  contactName        String
  email              String
  phone              String
  status             String        @default("Prospect")
  source             String        @default("Inbound")
  priority           String        @default("Normale")
  owner              String?
  notes              String?       @db.Text
  nextFollowUpAt     DateTime?
  lastContactAt      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  registrations      Inscription[]
  tasks              CompanyTask[]
  interactions       CompanyInteraction[]

  @@unique([name, email])
}

model CompanyTask {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  description String?   @db.Text
  status      String    @default("A faire")
  dueDate     DateTime?
  owner       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyInteraction {
  id         String    @id @default(cuid())
  companyId  String
  type       String
  channel    String?
  summary    String    @db.Text
  owner      String?
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

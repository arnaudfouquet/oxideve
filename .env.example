PORT=3000
SITE_URL=https://oxideve.fr
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Utilisée pour signer les cookies de session admin. Si absente, ADMIN_PASSWORD est
# utilisé comme secret de repli (fonctionne, mais une valeur dédiée est préférable).
ADMIN_SESSION_SECRET=
INFOMANIAK_RESTART_COMMAND=
QUEOVAL_API_TOKEN=
# SMTP pour l'envoi des emails de confirmation de bulletin d'inscription (mailService.js).
# Si SMTP_HOST est vide, l'envoi d'email est désactivé (mode dégradé) et seule la sauvegarde
# en base est effectuée.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@oxideve.fr
